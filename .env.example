# ============================================================================
# Supabase — required for everything (auth, db, storage)
# Get these from: Supabase → Project Settings → API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-role key — SERVER ONLY. Bypasses RLS. Used by lib/supabase/admin.ts
# for /admin/* pages, account deletion, and the sitemap public-maps query.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Site URL — used for absolute links in emails + sitemap + OG tags
# ============================================================================
# Local dev:   http://localhost:3000
# Production:  https://www.squishymind.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# OpenAI — powers the AI-expand-this-node feature
# ============================================================================
# https://platform.openai.com/api-keys
# Uses gpt-4o-mini (cheap). Optional in dev — feature degrades gracefully
# if missing.
OPENAI_API_KEY=sk-...

# ============================================================================
# ElevenLabs — Squishy voice agent + pre-baked SFX clips
# ============================================================================
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Main Squishy voice ID. Find a voice in the ElevenLabs library and grab
# its ID from the URL or Settings → Voices.
ELEVENLABS_VOICE_ID=...

# Optional persona voice IDs — only used by `npm run sfx:delete` and
# `npm run sfx:brain` to pre-bake the rotating clips committed under
# public/sfx/. The deployed app reads the static files, so these can be
# left empty in production envs.
ELEVENLABS_KAWAII_VOICE_ID=vr24ecog1HynlBKXovTE
ELEVENLABS_SCIFI_VOICE_ID=u2rE0u0hBg9OzDrd9uqZ
ELEVENLABS_NOIR_VOICE_ID=kAgzhv5JMApdFLmNW1mA
